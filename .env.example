# ==========================================
# 1. Server Configuration
# ==========================================
PORT=3000

# ==========================================
# 2. Africa's Talking Configuration
# ==========================================
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here
AT_PHONE_NUMBER=+254711082000

# Outbound API Endpoints (Leave as default)
AT_VOICE_URL=https://voice.africastalking.com/call
AT_TRANSFER_URL=https://voice.africastalking.com/callTransfer

# ==========================================
# 3. Public Webhook URLs (Deployed URL / ngrok)
# ==========================================
# Enter this into the Africa's Talking Voice Dashboard:
# Callback URL: https://your-domain.onrender.com/voice/callback
# Event URL:    https://your-domain.onrender.com/voice/events
PUBLIC_CALLBACK_URL=https://your-domain.onrender.com/voice/callback

# ==========================================
# 4. Groq AI Voice Agent Configuration
# ==========================================
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here

# Multi-Key Setup: Rate-limit isolation for speech/audio vs LLM chat vs Audio Arrangement
# Dedicated key for Whisper Speech-to-Text / Audio processing
GROQ_TTS_KEY=your_dedicated_audio_whisper_groq_key_here
# Dedicated key for Conversational LLM reasoning and MoMo tool calls
GROQ_LLM_KEY=your_dedicated_llm_reasoning_groq_key_here
# Dedicated key for AI Audio Decision & Arranger (matches clips to speech)
GROQ_AUDIO_AGENT_KEY=your_dedicated_audio_agent_key_here

# University of Ghana HCI Lab Akan Twi Speech Services
UG_HCI_LAB_API_KEY=your_ug_hci_lab_speech_key_here
UG_HCI_LAB_URL=https://lab-subscription-platform.vercel.app

# ==========================================
# 4b. Dashboard / Paid Endpoint Protection (OPTIONAL but recommended)
# ==========================================
# Protects /api/call, /api/call-transfer and MoMo money-movement endpoints.
# If set, clients must send it as the `x-api-key` header.
# If unset, those endpoints are only reachable from localhost (loopback).
DASHBOARD_API_KEY=your_dashboard_api_key_here

# Max milliseconds to wait for the AI before answering AT webhooks with a
# keep-alive XML (prevents call hangups during slow Groq rate-limit retries).
VOICE_WEBHOOK_TIMEOUT_MS=11000

# Telephony Silence Detection & Record Limits (Quick Wins for Low Latency)
# Silence timeout in seconds before AT finalizes recording (default: 2)
AT_RECORD_TIMEOUT=2
# Max duration in seconds for caller recording turn (default: 12)
AT_RECORD_MAX_LENGTH=12

# ==========================================
# 5. MTN Mobile Money Open API (Sandbox)
# ==========================================
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_ENVIRONMENT=sandbox
MOMO_CURRENCY=GHS
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=your_disbursement_subscription_key_here
MOMO_COLLECTION_SUBSCRIPTION_KEY=your_collection_subscription_key_here
MOMO_API_USER_ID=your_momo_api_user_uuid_here
MOMO_API_KEY=your_momo_api_key_here
MOMO_CALLBACK_HOST=webhook.site
