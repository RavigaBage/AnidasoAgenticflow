# ==========================================
# 1. Server Configuration
# ==========================================
PORT=3000

# ==========================================
# 2. Africa's Talking Configuration
# ==========================================
AT_USERNAME=sandbox
AT_API_KEY=your_africastalking_api_key_here
AT_PHONE_NUMBER=+254711082000

# Outbound API Endpoints (Leave as default)
AT_VOICE_URL=https://voice.africastalking.com/call
AT_TRANSFER_URL=https://voice.africastalking.com/callTransfer

# ==========================================
# 3. Public Webhook URLs (Deployed URL / ngrok)
# ==========================================
# Enter this into the Africa's Talking Voice Dashboard:
# Callback URL: https://your-domain.onrender.com/voice/callback
# Event URL:    https://your-domain.onrender.com/voice/events
PUBLIC_CALLBACK_URL=https://your-domain.onrender.com/voice/callback

# ==========================================
# 4. Groq AI Voice Agent Configuration
# ==========================================
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=your_groq_api_key_here

# ==========================================
# 5. MTN Mobile Money Open API (Sandbox)
# ==========================================
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_ENVIRONMENT=sandbox
MOMO_CURRENCY=GHS
MOMO_DISBURSEMENT_SUBSCRIPTION_KEY=your_disbursement_subscription_key_here
MOMO_COLLECTION_SUBSCRIPTION_KEY=your_collection_subscription_key_here
MOMO_API_USER_ID=your_momo_api_user_uuid_here
MOMO_API_KEY=your_momo_api_key_here
MOMO_CALLBACK_HOST=webhook.site
